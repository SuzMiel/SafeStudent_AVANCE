<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAlerta"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1B365D"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="SafeStudent"
        app:titleTextColor="@android:color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/btnDemoAvisos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVISOS"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#2E6F40"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/btnDemoAlerta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALERTA"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#B71C1C"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mapa de Sedes Tacna:"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="6dp" />

        <!-- Contenedor con esquinas redondeadas para el mapa y el indicador -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- MapView de OSMDroid -->
                <org.osmdroid.views.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Cartel indicador dinámico por bordes -->
                <LinearLayout
                    android:id="@+id/layoutIndicadorConoSur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#1B365D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cono Sur"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp" />

                    <ImageView
                        android:id="@+id/imgFlechaConoSur"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/arrow_up_float"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <!-- Indicador 2: Senati Ciudad Nueva -->
                <LinearLayout
                    android:id="@+id/layoutIndicadorCiudadNueva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#D32F2F"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ciudad Nueva"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp" />

                    <ImageView
                        android:id="@+id/imgFlechaCiudadNueva"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/arrow_up_float"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <!-- Botón flotante para centrar en mi ubicación -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnMiUbicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Mi Ubicación"
                    app:backgroundTint="@android:color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_menu_mylocation"
                    app:tint="#1B365D" />

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Directorio y Contacto Rapido:"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@android:drawable/btn_dropdown" />

            <Spinner
                android:id="@+id/spContacto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:background="@android:drawable/btn_dropdown" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLlamarSeleccionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Realizar Llamada de Contacto"
            android:backgroundTint="#1B365D"
            android:textColor="@android:color/white" />

    </LinearLayout>
</LinearLayout>